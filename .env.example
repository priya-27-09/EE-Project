# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=ai_civic_guardian
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@localhost:5432/ai_civic_guardian

# Authentication / Security
JWT_SECRET_KEY=replace_with_a_secure_random_key_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server ports
FLASK_PORT=5000
FASTAPI_PORT=8000

# Blockchain (Step 10 - Ganache / Web3)
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_ACCOUNT_ADDRESS=
BLOCKCHAIN_CONFIRMATIONS=1

# Chatbot & RAG Knowledge Base (Steps 11 + 12)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.35
GEMINI_API_KEY=

