# Render Deployment Environment Variables Template (DO NOT COMMIT REAL SECRETS)
# Copy these values into Render Dashboard -> Environment Variables

ENVIRONMENT=production
PORT=10000

# PostgreSQL Connection (Provided by Render PostgreSQL or external provider like Supabase/Neon/RDS)
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
# (Note: Render's legacy postgres:// prefix is automatically normalized to postgresql+psycopg:// by the app)
DATABASE_URL=postgresql+psycopg://user:password@host.render.com:5432/ai_civic_guardian

# Authentication Secret (Generate a strong 64-char key in Render dashboard or openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_secret_in_render_dashboard
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service Area Boundary Check (False allows testing from any geographic coordinates)
COIMBATORE_SERVICE_BOUNDARY_ENFORCED=false

# Optional Blockchain Integration (keep empty if using local/unconfigured mode)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

